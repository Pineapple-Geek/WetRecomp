{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "switch-release",
            "displayName": "Nintendo Switch Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/switch",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/Switch.cmake",
                "REXGLUE_PLATFORM_SWITCH": "ON",
                "REXGLUE_SWITCH_DEKO3D": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "switch-release",
            "configurePreset": "switch-release"
        }
    ]
}
